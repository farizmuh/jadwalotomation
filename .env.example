# Database Connection (MySQL / MariaDB)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://root:@127.0.0.1:3306/jadwal_sekolah"

# Admin Authentication
# Username dan password untuk login admin
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ganti_password_ini"
# Secret key untuk signing session cookie (ganti dengan string acak yang panjang)
AUTH_SECRET="ganti-dengan-secret-key-yang-aman-dan-panjang"
